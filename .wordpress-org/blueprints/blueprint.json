{
  "$schema": "https://playground.wordpress.net/blueprint-schema.json",
  "meta": {
    "title": "Stillgate",
    "description": "Start a freeze from the control room, then see what an editor sees and what the receipt reports.",
    "author": "digibold",
    "categories": [
      "Admin",
      "Developer Tools"
    ]
  },
  "landingPage": "/wp-admin/tools.php?page=stillgate",
  "preferredVersions": {
    "php": "8.3",
    "wp": "latest"
  },
  "steps": [
    {
      "step": "login",
      "username": "admin",
      "password": "password"
    },
    {
      "step": "installPlugin",
      "pluginData": {
        "resource": "wordpress.org/plugins",
        "slug": "stillgate"
      },
      "options": {
        "activate": true
      }
    },
    {
      "step": "runPHP",
      "code": "<?php require '/wordpress/wp-load.php'; update_option( 'blogname', 'Harbor Journal' ); update_option( 'blogdescription', 'Local news and long reads' ); foreach ( ['Harbor Authority approves the northern quay extension', 'What the new ferry timetable means for commuters', 'Ten years of the Saturday market', 'Council budget: where the money goes', 'Opinion: the library hours were never the problem', 'Lighthouse restoration reaches its final phase'] as $title ) { wp_insert_post( array( 'post_title' => $title, 'post_status' => 'publish', 'post_author' => 1, 'post_content' => '<!-- wp:paragraph --><p>Copy for ' . $title . '.</p><!-- /wp:paragraph -->' ) ); }"
    }
  ]
}
