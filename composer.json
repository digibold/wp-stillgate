{
	"name": "digibold/wp-deployment-guard",
	"description": "Editorial freeze for WordPress during deployments, migrations and maintenance windows.",
	"type": "wordpress-plugin",
	"license": "GPL-2.0-or-later",
	"keywords": [
		"wordpress",
		"wordpress-plugin",
		"deployment",
		"migration",
		"content-freeze"
	],
	"homepage": "https://github.com/digibold/wp-deployment-guard",
	"authors": [
		{
			"name": "Linards Lazdins",
			"homepage": "https://createit.lv"
		}
	],
	"support": {
		"issues": "https://github.com/digibold/wp-deployment-guard/issues",
		"source": "https://github.com/digibold/wp-deployment-guard",
		"security": "https://github.com/digibold/wp-deployment-guard/blob/main/SECURITY.md"
	},
	"require": {
		"php": "^8.1"
	},
	"require-dev": {
		"dealerdirect/phpcodesniffer-composer-installer": "^1.2",
		"phpcompatibility/phpcompatibility-wp": "^2.1.8",
		"phpunit/phpunit": "^9.6",
		"roots/wordpress-no-content": "^6.6 || ^7.0",
		"wp-coding-standards/wpcs": "^3.4.1",
		"wp-phpunit/wp-phpunit": "^6.6 || ^7.0",
		"yoast/phpunit-polyfills": "^1.1"
	},
	"autoload-dev": {
		"psr-4": {
			"Digibold\\DeploymentGuard\\Tests\\": "tests/"
		}
	},
	"config": {
		"allow-plugins": {
			"dealerdirect/phpcodesniffer-composer-installer": true,
			"roots/wordpress-core-installer": true
		},
		"sort-packages": true
	},
	"scripts": {
		"lint": "find . -name '*.php' -not -path './vendor/*' -not -path './wordpress/*' -print0 | xargs -0 -n1 php -l",
		"phpcs": "phpcs",
		"phpcbf": "phpcbf",
		"test:unit": "phpunit --configuration phpunit.xml.dist",
		"test:integration": [
			"phpunit --configuration phpunit-integration.xml.dist --testsuite integration",
			"phpunit --configuration phpunit-integration.xml.dist --testsuite ajax",
			"phpunit --configuration phpunit-integration.xml.dist --testsuite xmlrpc"
		],
		"test:e2e": "bash tests/e2e/cli.sh",
		"version-check": "php bin/check-version.php"
	},
	"scripts-descriptions": {
		"lint": "Check PHP syntax of all plugin and test files.",
		"phpcs": "Run PHP_CodeSniffer with WordPress Coding Standards.",
		"phpcbf": "Automatically fix coding standard violations where possible.",
		"test:unit": "Run unit tests that do not need WordPress.",
		"test:integration": "Run integration tests against WordPress and MySQL.",
		"test:e2e": "Run end-to-end WP-CLI tests against a throwaway WordPress site.",
		"version-check": "Verify that version numbers are consistent across files."
	}
}
